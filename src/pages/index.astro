---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            class="bg-slate-800/60 backdrop-blur-sm rounded-xl border border-slate-700/50 p-6 mb-8 flex flex-col sm:flex-row sm:flex-wrap gap-6"
            data-testid="game-filters"
          >
            <fieldset class="flex-1 min-w-[200px]">
              <legend class="text-sm font-semibold text-slate-200 mb-2">Category</legend>
              <div class="flex flex-wrap gap-3" data-testid="category-filter-group">
                {categories.map((category) => (
                  <label
                    class="inline-flex items-center gap-2 text-sm text-slate-300 cursor-pointer"
                    for={`category-filter-${category.id}`}
                  >
                    <input
                      type="checkbox"
                      id={`category-filter-${category.id}`}
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${category.id}`}
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="flex-1 min-w-[200px]">
              <label for="publisher-filter" class="block text-sm font-semibold text-slate-200 mb-2">
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full sm:w-auto bg-slate-900 border border-slate-600 text-slate-200 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <div class="flex items-end">
              <button
                type="button"
                id="clear-filters"
                class="text-sm text-blue-400 hover:text-blue-300 font-medium underline-offset-2 hover:underline focus:ring-2 focus:ring-blue-500 focus:outline-none rounded"
                data-testid="clear-filters-button"
              >
                Clear filters
              </button>
            </div>
          </div>

          <p class="text-sm text-slate-400 mb-4" role="status" aria-live="polite" data-testid="results-count">
            {`Showing ${games.length} of ${games.length} games`}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="no-results-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filtersContainer = document.querySelector<HTMLDivElement>('[data-testid="game-filters"]');
  const grid = document.querySelector<HTMLDivElement>('[data-testid="games-grid"]');
  const resultsCount = document.querySelector<HTMLParagraphElement>('[data-testid="results-count"]');
  const emptyState = document.querySelector<HTMLDivElement>('[data-testid="no-results-empty-state"]');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-filters');

  if (filtersContainer && grid && resultsCount && emptyState) {
    const gridEl = grid;
    const resultsCountEl = resultsCount;
    const emptyStateEl = emptyState;
    const cards = Array.from(gridEl.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const totalCount = cards.length;
    const categoryCheckboxes = Array.from(
      filtersContainer.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherSelect = filtersContainer.querySelector<HTMLSelectElement>('#publisher-filter');

    function applyFilters(): void {
      const activeCategoryIds = new Set(
        categoryCheckboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.value),
      );
      const selectedPublisherId = publisherSelect?.value ?? '';

      let visibleCount = 0;
      for (const card of cards) {
        const matchesCategory = activeCategoryIds.size === 0 || activeCategoryIds.has(card.dataset.categoryId ?? '');
        const matchesPublisher = selectedPublisherId === '' || card.dataset.publisherId === selectedPublisherId;
        const isVisible = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) {
          visibleCount += 1;
        }
      }

      resultsCountEl.textContent = `Showing ${visibleCount} of ${totalCount} games`;
      gridEl.classList.toggle('hidden', visibleCount === 0);
      emptyStateEl.classList.toggle('hidden', visibleCount !== 0);
    }

    for (const checkbox of categoryCheckboxes) {
      checkbox.addEventListener('change', applyFilters);
    }
    publisherSelect?.addEventListener('change', applyFilters);
    clearButton?.addEventListener('click', () => {
      for (const checkbox of categoryCheckboxes) {
        checkbox.checked = false;
      }
      if (publisherSelect) {
        publisherSelect.value = '';
      }
      applyFilters();
    });
  }
</script>
